{
  "tap": "MagmaMoose/tap",
  "formula_namespace": "MagmaMoose",
  "maintainers": [
    {
      "name": "Caleb Sargeant",
      "github": "CalebSargeant"
    }
  ],
  "homepage": "https://github.com/MagmaMoose/homebrew-tap",
  "description": "Centralised Homebrew tap for various CLI tools with automated updates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MagmaMoose/homebrew-tap.git"
  },
  "formulas": {
    "auto-heijn": {
      "description": "Turn an Apple Reminders shopping list into an Albert Heijn add-to-list link",
      "homepage": "https://github.com/CalebSargeant/auto-heijn",
      "version": "0.1.0",
      "status": "active"
    },
    "chargate": {
      "description": "Net-new security and lint gate with a global git-hooks installer",
      "homepage": "https://github.com/MagmaMoose/chargate",
      "version": "2.11.1",
      "status": "active"
    },
    "maniforge": {
      "description": "Terraform-like tool for managing Kubernetes applications",
      "homepage": "https://github.com/calebsargeant/maniforge",
      "version": "1.2.0",
      "status": "active"
    },
    "transcribe": {
      "description": "Video/audio transcription with auto-watch, OpenAI summarization, and Slack notifications",
      "homepage": "https://github.com/calebsargeant/transcribe",
      "version": "1.0.8",
      "status": "active"
    }
  },
  "auto_update": {
    "enabled": true,
    "schedule": "daily",
    "verify_checksum": true
  },
  "ci": {
    "enabled": true,
    "platforms": ["macos-13", "macos-14"],
    "audit": true,
    "test": true
  }
}
